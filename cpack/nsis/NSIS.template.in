Section "-Add to path"
Push $INSTDIR\bin
StrCmp "@CPACK_NSIS_MODIFY_PATH@" "ON" 0 doNotAddToPath
StrCmp $DO_NOT_ADD_TO_PATH "1" doNotAddToPath 0
Call AddToPath
doNotAddToPath:
SectionEnd

;--------------------------------
; Read custom optional parameters
Function ReadCustomOptionalParameters
; Include usefull stuff
!include FileFunc.nsh
!include LogicLib.nsh

; In multi-user mode MultiUser.nsh already inserts GetParameters/GetOptions (because MULTIUSER_INSTALLMODE_COMMANDLINE is defined),
; so only insert them ourselves in admin-only mode to avoid "Function already exists" errors.
!ifndef MULTIUSER_ENABLED
!insertmacro GetParameters
!insertmacro GetOptions
!endif
${GetParameters} $R0
ClearErrors

; Read /NOPCAP option
!ifdef WinPcap
${GetOptions} $R0 /NOPCAP $0
IfErrors defaultPcap
!insertmacro UnselectSection ${WinPcap}
defaultPcap:
!endif

; Read /LAUNCH option
StrCpy $ShouldLaunch 0
${GetOptions} $R0 /LAUNCH $0
IfErrors defaultNoLaunch
StrCpy $ShouldLaunch 1
defaultNoLaunch:

FunctionEnd

;--------------------------------
; Create custom pages
Function InstallOptionsPage
!insertmacro MUI_HEADER_TEXT "Install Options" "Choose options for installing @CPACK_NSIS_PACKAGE_NAME@"
!insertmacro INSTALLOPTIONS_DISPLAY "NSIS.InstallOptions.ini"
FunctionEnd


;--------------------------------
; run application if installation success without admin privileges
Function RunAppAsUser
Exec '"$WINDIR\explorer.exe" "${BINARY_TO_RUN}"'
FunctionEnd

;--------------------------------
; run application if installation was silent
Function .onInstSuccess
!ifdef BINARY_TO_RUN
StrCmp $ShouldLaunch "0" dont_run_binary
IfSilent 0 dont_run_binary
Call RunAppAsUser
dont_run_binary:
!endif
FunctionEnd

;--------------------------------
; Uninstaller initialization
Function un.onInit

!ifdef MULTIUSER_ENABLED
    ; MultiUser handles privilege check and SHCTX
    !insertmacro MULTIUSER_UNINIT
!else
    ; Original admin-only behavior
    ClearErrors
    UserInfo::GetName
    IfErrors un_noLM
    Pop $0
    UserInfo::GetAccountType
    Pop $1
    StrCmp $1 "Admin" 0 +3
    SetShellVarContext all
    Goto un_done
    StrCmp $1 "Power" 0 +3
    SetShellVarContext all
    Goto un_done

    un_noLM:
    ;Get installation folder from registry if available

    un_done:
!endif

FunctionEnd

;--- Add/Remove callback functions: ---
!macro SectionList MacroName
;This macro used to perform operation on multiple sections.
;List all of your components in following manner here.
@CPACK_NSIS_COMPONENT_SECTION_LIST@
!macroend

Section -FinishComponents
;Removes unselected components and writes component status to registry
!insertmacro SectionList "FinishSection"

!ifdef CPACK_NSIS_ADD_REMOVE
; Get the name of the installer executable
System::Call 'kernel32::GetModuleFileNameA(i 0, t .R0, i 1024) i r1'
StrCpy $R3 $R0

; Strip off the last 13 characters, to see if we have AddRemove.exe
StrLen $R1 $R0
IntOp $R1 $R0 - 13
StrCpy $R2 $R0 13 $R1
StrCmp $R2 "AddRemove.exe" addremove_installed

; We're not running AddRemove.exe, so install it
CopyFiles $R3 $INSTDIR\AddRemove.exe

addremove_installed:
!endif
SectionEnd
;--- End of Add/Remove callback functions ---

;--------------------------------
; Component dependencies
Function .onSelChange
!insertmacro SectionList MaybeSelectionChanged
FunctionEnd

;--------------------------------
;Uninstaller Section

Section "Uninstall"
ReadRegStr $START_MENU SHCTX \
"Software\Microsoft\Windows\CurrentVersion\Uninstall\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@" "StartMenu"
;MessageBox MB_OK "Start menu is in: $START_MENU"
ReadRegStr $DO_NOT_ADD_TO_PATH SHCTX \
"Software\Microsoft\Windows\CurrentVersion\Uninstall\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@" "DoNotAddToPath"
ReadRegStr $ADD_TO_PATH_ALL_USERS SHCTX \
"Software\Microsoft\Windows\CurrentVersion\Uninstall\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@" "AddToPathAllUsers"
ReadRegStr $ADD_TO_PATH_CURRENT_USER SHCTX \
"Software\Microsoft\Windows\CurrentVersion\Uninstall\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@" "AddToPathCurrentUser"
;MessageBox MB_OK "Add to path: $DO_NOT_ADD_TO_PATH all users: $ADD_TO_PATH_ALL_USERS"
ReadRegStr $INSTALL_DESKTOP SHCTX \
"Software\Microsoft\Windows\CurrentVersion\Uninstall\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@" "InstallToDesktop"
;MessageBox MB_OK "Install to desktop: $INSTALL_DESKTOP "

@CPACK_NSIS_EXTRA_UNINSTALL_COMMANDS@

;Remove files we installed.
;Keep the list of directories here in sync with the File commands above.
@CPACK_NSIS_DELETE_FILES@
@CPACK_NSIS_DELETE_DIRECTORIES@

!ifdef CPACK_NSIS_ADD_REMOVE
;Remove the add/remove program
Delete "$INSTDIR\AddRemove.exe"
!endif

;Remove the uninstaller itself.
Delete "$INSTDIR\Uninstall.exe"
DeleteRegKey SHCTX "Software\Microsoft\Windows\CurrentVersion\Uninstall\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@"

;Remove the installation directory if it is empty.
RMDir "$INSTDIR"

; Remove the registry entries.
DeleteRegKey SHCTX "Software\@CPACK_PACKAGE_VENDOR@\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@"

; Removes all optional components
!insertmacro SectionList "RemoveSection_CPack"

!insertmacro MUI_STARTMENU_GETFOLDER Application $MUI_TEMP

Delete "$SMPROGRAMS\$MUI_TEMP\Uninstall @CPACK_PACKAGE_INSTALL_REGISTRY_KEY@.lnk"
@CPACK_NSIS_DELETE_ICONS@
@CPACK_NSIS_DELETE_ICONS_EXTRA@

;Delete empty start menu parent directories
StrCpy $MUI_TEMP "$SMPROGRAMS\$MUI_TEMP"

startMenuDeleteLoop:
ClearErrors
RMDir $MUI_TEMP
GetFullPathName $MUI_TEMP "$MUI_TEMP\.."

IfErrors startMenuDeleteLoopDone

StrCmp "$MUI_TEMP" "$SMPROGRAMS" startMenuDeleteLoopDone startMenuDeleteLoop
startMenuDeleteLoopDone:

; If the user changed the shortcut, then untinstall may not work. This should
; try to fix it.
StrCpy $MUI_TEMP "$START_MENU"
Delete "$SMPROGRAMS\$MUI_TEMP\Uninstall @CPACK_PACKAGE_INSTALL_REGISTRY_KEY@.lnk"
@CPACK_NSIS_DELETE_ICONS_EXTRA@

;Delete empty start menu parent directories
StrCpy $MUI_TEMP "$SMPROGRAMS\$MUI_TEMP"

secondStartMenuDeleteLoop:
ClearErrors
RMDir $MUI_TEMP
GetFullPathName $MUI_TEMP "$MUI_TEMP\.."

IfErrors secondStartMenuDeleteLoopDone

StrCmp "$MUI_TEMP" "$SMPROGRAMS" secondStartMenuDeleteLoopDone secondStartMenuDeleteLoop
secondStartMenuDeleteLoopDone:

DeleteRegKey /ifempty SHCTX "Software\@CPACK_PACKAGE_VENDOR@\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@"

Push $INSTDIR\bin
StrCmp $DO_NOT_ADD_TO_PATH_ "1" doNotRemoveFromPath 0
Call un.RemoveFromPath
doNotRemoveFromPath:
SectionEnd

;--------------------------------
; Installer initialization

Function .onInit

!ifdef MULTIUSER_ENABLED
    ; Multi-user mode: MultiUser positions SHCTX, may elevate, etc.
    !insertmacro MULTIUSER_INIT
!else
    ; Admin-only mode: force SHCTX = HKLM (we already required admin level).
    SetShellVarContext all
    StrCpy $SV_ALLUSERS "AllUsers"
!endif

StrCmp "@CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL@" "ON" 0 inst

; Detect a previously installed version and remember in which registry root (hive) it lives:
;   HKLM = system-wide (removing it needs elevation)
;   HKCU = per-user     (no elevation needed)
; $PREV_INSTALL_REG_ROOT drives the uninstall strategy further down.
!ifdef MULTIUSER_ENABLED
StrCpy $PREV_INSTALL_REG_ROOT ""
ReadRegStr $0 HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@" "UninstallString"
StrCmp $0 "" 0 prev_is_hklm
ReadRegStr $0 HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@" "UninstallString"
StrCmp $0 "" inst prev_is_hkcu
prev_is_hklm:
StrCpy $PREV_INSTALL_REG_ROOT "HKLM"
Goto has_prev
prev_is_hkcu:
StrCpy $PREV_INSTALL_REG_ROOT "HKCU"
Goto has_prev
!else
; Admin-only mode: previous install is always system-wide (SHCTX = HKLM).
ReadRegStr $0 SHCTX "Software\Microsoft\Windows\CurrentVersion\Uninstall\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@" "UninstallString"
StrCmp $0 "" inst
!endif

has_prev:
; Check if currently installed version is newer (read from the registry root we found it in)
!ifdef MULTIUSER_ENABLED
StrCmp $PREV_INSTALL_REG_ROOT "HKLM" prev_vers_hklm prev_vers_hkcu
prev_vers_hklm:
ReadRegDWORD $PrevInstVers HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@" "CurrInstFullVers"
Goto prev_vers_done
prev_vers_hkcu:
ReadRegDWORD $PrevInstVers HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@" "CurrInstFullVers"
prev_vers_done:
!else
ReadRegDWORD $PrevInstVers SHCTX "Software\Microsoft\Windows\CurrentVersion\Uninstall\@CPACK_PACKAGE_INSTALL_REGISTRY_KEY@" "CurrInstFullVers"
!endif
IntCmp ${CURR_INST_FULL_VERS} $PrevInstVers samevers morerecent

; Newer version
MessageBox MB_YESNOCANCEL|MB_ICONEXCLAMATION \
"An older version of @CPACK_NSIS_PACKAGE_NAME@ is already installed. $\n$\nDo you want to uninstall the old version before installing the new one?" \
/SD IDYES IDYES uninst IDNO inst
Abort

samevers:
MessageBox MB_YESNOCANCEL|MB_ICONEXCLAMATION \
"The same version of @CPACK_NSIS_PACKAGE_NAME@ is already installed. $\n$\nDo you want to uninstall it before installing the new one?" \
/SD IDCANCEL IDYES uninst IDNO inst
Abort

;More recent version already installed
morerecent:
MessageBox MB_YESNO|MB_ICONEXCLAMATION \
"A more recent version of @CPACK_NSIS_PACKAGE_NAME@ is already installed. $\n$\nDo you really want to install this older version (currently installed version will be removed first)?" \
/SD IDNO IDYES uninst
Abort

;No installation
noinst:
Abort

;Run the uninstaller
uninst:
ClearErrors
StrLen $2 "\Uninstall.exe"
StrCpy $3 $0 -$2 # remove "\Uninstall.exe" from UninstallString to get path

!ifdef MULTIUSER_ENABLED
; A system-wide (HKLM) previous install can only be removed with admin rights,
; which the current (possibly unelevated) process does not necessarily have -
; and we must NOT elevate the whole installer, otherwise a per-user new install
; would land in the elevating admin's profile instead of the user's. So we run
; only the old uninstaller elevated, as a separate process, via the "runas" verb.
; A per-user (HKCU) previous install needs no elevation and is removed in place.
StrCmp $PREV_INSTALL_REG_ROOT "HKLM" uninst_elevated uninst_inplace

uninst_elevated:
; Launch elevated (UAC prompt, shown even for /S silent installs - acceptable).
; No _?= so the uninstaller copies itself to TEMP and fully removes the previous
; install, including its directory. ExecShellWait returns as soon as the launcher
; process exits, so poll until the old uninstaller is gone (with a timeout).
ExecShellWait "runas" "$0" "/S"
IfErrors uninst_uac_declined
StrCpy $4 0
uninst_wait:
Sleep 500
IfFileExists "$0" 0 inst         ; uninstaller removed -> previous version gone
IntOp $4 $4 + 1
IntCmp $4 240 uninst_timeout uninst_wait uninst_timeout   ; 240 * 500ms = ~120s
uninst_timeout:
MessageBox MB_OK|MB_ICONSTOP "The previously installed version could not be removed (operation timed out)." /SD IDOK
Abort
uninst_uac_declined:
MessageBox MB_OK|MB_ICONSTOP "Administrator rights are required to remove the previously installed system-wide version. Please retry and accept the elevation prompt." /SD IDOK
Abort

uninst_inplace:
!endif
; Per-user previous install, or admin-only mode (already elevated): in place.
ExecWait '"$0" /S _?=$3' ;Do not copy the uninstaller to a temp file
IfErrors uninst_failed inst
uninst_failed:
MessageBox MB_OK|MB_ICONSTOP "Uninstall failed." /SD IDOK
Abort


inst:
; Read custom optional parameters
Call ReadCustomOptionalParameters

; Reads components status for registry
!insertmacro SectionList "InitSection"

; Executes initialization commands
@CPACK_NSIS_EXTRA_INIT_COMMANDS@

; Default-installdir detection (best-effort, used by other CPack hooks)
StrCpy $IS_DEFAULT_INSTALLDIR 0
!ifdef MULTIUSER_ENABLED
StrCmp "$INSTDIR" "$PROGRAMFILES64\@CPACK_PACKAGE_INSTALL_DIRECTORY@" 0 +2
StrCpy $IS_DEFAULT_INSTALLDIR 1
; Sync legacy variable for backward-compat with custom CPack hooks
StrCpy $SV_ALLUSERS $MultiUser.InstallMode
!else
StrCmp "$INSTDIR" "@CPACK_NSIS_INSTALL_ROOT@\@CPACK_PACKAGE_INSTALL_DIRECTORY@" 0 +2
StrCpy $IS_DEFAULT_INSTALLDIR 1
!endif

StrCmp "@CPACK_NSIS_MODIFY_PATH@" "ON" 0 noOptionsPage
!insertmacro INSTALLOPTIONS_EXTRACT "NSIS.InstallOptions.ini"

noOptionsPage:
FunctionEnd
