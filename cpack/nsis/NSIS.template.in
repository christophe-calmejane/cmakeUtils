@CPACK_NSIS_CREATE_ICONS_EXTRA@
CreateShortCut "$SMPROGRAMS\$STARTMENU_FOLDER\Uninstall @CPACK_PACKAGE_INSTALL_REGISTRY_KEY@.lnk" "$INSTDIR\Uninstall.exe"

